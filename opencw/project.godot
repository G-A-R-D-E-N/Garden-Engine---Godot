[rendering]

anti_aliasing/quality/temporal_transition_metadata=true
anti_aliasing/quality/use_debanding=true
limits/cluster_builder/max_clustered_elements=2048.0
rendering_device/d3d12/max_resource_descriptors=1000000
rendering_device/d3d12/max_sampler_descriptors=2048
lights_and_shadows/use_physical_light_units=true
lights_and_shadows/contact_shadow/enabled=true
lights_and_shadows/contact_shadow/ray_completion_confidence=true
lights_and_shadows/contact_shadow/receiver_plane_rejection=true
lights_and_shadows/directional_shadow/soft_shadow_thin_casters=true
environment/screen_space_lighting/legacy_last_frame_source=false
environment/screen_space_lighting/temporal_validation=true
environment/volumetric_fog/use_temporal_clamp=true
global_illumination/ray_scene/alpha_test=true
visibility/dithered_instance_fade=true

[shader_globals]

hlod_camera={
