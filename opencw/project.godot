; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OpenCommonwealth"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.8", "C#", "Double Precision", "Forward Plus")

[autoload]

QuitDrain="*res://scripts/QuitDrain.cs"
AntiAliasingDefault="*res://scripts/AntiAliasingDefault.cs"
UiBootstrap="*res://scripts/UI/Bootstrap/UiBootstrap.cs"

[dotnet]

project/assembly_name="OpenCommonwealth"

[editor_plugins]

enabled=PackedStringArray("res://addons/asset_browser_cs/plugin.cfg", "res://addons/asset_converter_runner/plugin.cfg", "res://addons/cell_viewer/plugin.cfg", "res://addons/godot_mcp/plugin.cfg", "res://addons/oc_tools/plugin.cfg")

[garden]

water/imported_optics_classes=true
water/air_haze_interim=true
water/far_glow_shadowed=true
water/harbour_colour_seasons=true
water/harbour_colour_rain=true
water/harbour_colour_rain_decay_h=48.0
water/harbour_colour_rain_ref_mm=20.0
water/harbour_sea_state=false

